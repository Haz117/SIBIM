# ─────────────────────────────────────────────────────────────────────────────
# SIBIM — Variables de entorno
#
# 1. Copia este archivo:   cp .env.local.example .env.local
# 2. Rellena los valores con los de tu proyecto Supabase.
# 3. NUNCA subas .env.local a git — ya está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Encuéntralas en: Supabase Dashboard → Settings → API

# URL del proyecto (no es un secreto, solo identifica tu instancia)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key — acceso total a la BD, ignora RLS.
# NUNCA la pongas con el prefijo NEXT_PUBLIC_ ni la expongas al cliente.
# Encuéntrala en: Settings → API → service_role → Reveal
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ── Sesión ────────────────────────────────────────────────────────────────────
# Clave para firmar las cookies de sesión con HMAC.
# Genera una segura con: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
