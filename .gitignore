# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — el archivo .example SÍ se commitea (es el template)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI tooling — local settings only, never committed
.claude/
.cursor/
.copilot/

# PWA — workbox auto-generado (si se usa), sw.js es estático y sí se versiona
public/workbox-*.js
public/workbox-*.js.map
